/* iOS 27 浮动玻璃标签栏：强漫射模糊 + 高光描边 + 外侧暗边线 */

.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 24rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 999;
  /* 透明区域不拦截点击，页面底部内容仍可点到 */
  pointer-events: none;
}

.tabbar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.66);
  -webkit-backdrop-filter: blur(36rpx) saturate(180%);
  backdrop-filter: blur(36rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    0 0 0 1rpx rgba(16, 24, 40, 0.06),
    0 16rpx 40rpx rgba(16, 24, 40, 0.14);
  padding: 8rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
}

/* 按下反馈：保证点了有反应 */
.tab-hover {
  background: rgba(120, 130, 150, 0.16);
}

/* 选中态：带强调色的玻璃药丸（iOS 27 light：选中项用 tint glass） */
.tab-on {
  background: rgba(0, 122, 255, 0.14);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7),
    0 0 0 1rpx rgba(0, 122, 255, 0.16);
}

.tab-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #5c6371;
  letter-spacing: 0.5rpx;
}

.tab-text-on {
  font-size: 32rpx;
  font-weight: 700;
  color: #007aff;
}
