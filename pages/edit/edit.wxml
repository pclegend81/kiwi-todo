<view class="container" bindtap="onAnyTap">

  <view class="card">
    <view class="field">
      <text class="field-label">标题</text>
      <input
        class="input"
        placeholder="例如：缴电费"
        maxlength="40"
        value="{{title}}"
        disabled="{{isShared}}"
        bindinput="onTitle"
      />
    </view>
    <view class="field" style="border-bottom:none">
      <text class="field-label">备注</text>
    </view>
      <textarea
      class="note-area"
      placeholder="补充说明（选填）"
      maxlength="200"
      value="{{note}}"
      disabled="{{isShared}}"
      bindinput="onNote"
    />

    <!-- 图片备注：选图即传云存储，只存 fileID -->
    <view class="sub-field">
      <view class="row-between">
        <text class="field-label">图片</text>
        <text class="small muted">{{images.length}}/{{maxImages}}</text>
      </view>
      <view class="img-grid">
        <view
          wx:for="{{images}}"
          wx:key="*this"
          class="img-cell"
        >
          <image
            class="img-thumb"
            src="{{item}}"
            mode="aspectFill"
            data-src="{{item}}"
            bindtap="onPreviewImage"
          />
          <view
            wx:if="{{!isShared}}"
            class="img-del"
            data-index="{{index}}"
            catchtap="onDelImage"
          >×</view>
        </view>
        <view
          wx:if="{{!isShared && images.length < maxImages}}"
          class="img-add"
          bindtap="onAddImage"
        >＋</view>
      </view>
    </view>

    <!-- 位置备注：选点后存名称/地址/经纬度 -->
    <view class="sub-field">
      <view class="row-between">
        <text class="field-label">位置</text>
        <text wx:if="{{!location}}" class="small muted">未添加</text>
      </view>
      <view wx:if="{{location}}" class="loc-row" bindtap="onOpenLocation">
        <view class="loc-text">
          <text class="loc-name">{{location.name}}</text>
          <text class="small muted loc-addr">{{location.address}}</text>
        </view>
        <text class="small link">查看地图</text>
      </view>
      <view wx:if="{{!isShared}}" class="row" style="margin-top:20rpx">
        <view class="btn btn-ghost btn-inline" bindtap="onChooseLocation">{{location ? '重新选择' : '选择位置'}}</view>
        <view wx:if="{{location}}" class="btn btn-ghost btn-inline" bindtap="onClearLocation">清除位置</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="field" style="border-bottom:none">
      <text class="field-label">优先级</text>
      <view class="picker-value priority-{{priorityIndex === 0 ? 'high' : (priorityIndex === 2 ? 'low' : 'medium')}}" bindtap="openCp" data-type="priority">
        {{priorityNames[priorityIndex]}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">提醒日期</text>
      <view class="picker-value" bindtap="openCp" data-type="date">{{dateStr}} {{weekdayText}}</view>
    </view>
    <view class="field" style="border-bottom:none">
      <text class="field-label">提醒时间</text>
      <view class="picker-value" bindtap="openCp" data-type="time">{{timeStr}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">重复方式</text>
      <view class="picker-value" bindtap="openCp" data-type="repeat">{{repeatNames[repeatIndex]}}</view>
    </view>
    <!-- 按日历选择：日期清单 + 月历多选面板 -->
    <view wx:if="{{showDates}}" class="field" style="{{showHoliday ? '' : 'border-bottom:none'}}">
      <text class="field-label">选择提醒日期</text>
      <view class="picker-value" bindtap="openCalendar">{{repeatDates.length ? '已选 ' + repeatDates.length + ' 天' : '点击选择'}}</view>
    </view>
    <view wx:if="{{showDates && !repeatDates.length}}" class="sub-field">
      <view class="small muted">还没选日期。点上面「点击选择」打开月历，点哪天就哪天提醒；不预选任何一天。</view>
    </view>
    <view wx:if="{{showDates && repeatDates.length}}" class="sub-field">
      <view class="chip-wrap">
        <view
          wx:for="{{repeatDates}}"
          wx:key="*this"
          class="chip chip-sm chip-on"
          data-date="{{item}}"
          bindtap="onRemoveDate"
        >{{item}} ×</view>
      </view>
      <view class="small muted" style="margin-top:16rpx">每天各提醒一次，时刻统一用上面的「提醒时间」；点胶囊可去掉当天。最后一天过完就不再提醒。</view>
    </view>
    <view wx:if="{{showInterval}}" class="field">
      <text class="field-label">{{intervalLabel}}（{{intervalRange}}）</text>
      <input
        class="input"
        type="number"
        maxlength="3"
        value="{{intervalText}}"
        bindinput="onInterval"
      />
    </view>
    <view wx:if="{{showHoliday}}" class="field">
      <text class="field-label">中国大陆节假日跳过</text>
      <switch checked="{{skipHoliday}}" color="#2f6bff" disabled="{{isShared}}" bindchange="onSkipHoliday" />
    </view>
    <view wx:if="{{showHoliday && skipHoliday}}" class="field" style="border-bottom:none">
      <text class="field-label">遇到节假日</text>
      <view class="picker-value" bindtap="openCp" data-type="action">{{actionNames[actionIndex]}}</view>
    </view>
  </view>

  <!-- 重复的生效日期范围：只在几号到几号之间提醒（单端留空 = 该端不限） -->
  <view wx:if="{{showRange}}" class="card">
    <view class="field" style="{{rangeEnabled ? '' : 'border-bottom:none'}}">
      <text class="field-label">限定生效日期</text>
      <switch checked="{{rangeEnabled}}" color="#2f6bff" disabled="{{isShared}}" bindchange="onRangeToggle" />
    </view>
    <view wx:if="{{rangeEnabled}}" class="field">
      <text class="field-label">开始日期</text>
      <view class="picker-value" bindtap="openCp" data-type="rangeStart">{{rangeStart || '不限'}}</view>
    </view>
    <view wx:if="{{rangeEnabled}}" class="field" style="border-bottom:none">
      <text class="field-label">结束日期</text>
      <view class="picker-value" bindtap="openCp" data-type="rangeEnd">{{rangeEnd || '不限'}}</view>
    </view>
    <view wx:if="{{rangeEnabled}}" class="small muted" style="margin-top:16rpx">{{rangeHint}}</view>
  </view>

  <view class="card">
    <view class="title">提醒预览</view>
    <view class="divider"></view>
    <view class="row-between">
      <text class="small muted">首次提醒</text>
      <text class="small">{{previewFirst}}</text>
    </view>
    <view class="row-between" style="margin-top:12rpx">
      <text class="small muted">下一次提醒</text>
      <text class="small next-text">{{previewNext}}</text>
    </view>
    <view class="small muted" style="margin-top:12rpx">{{previewTip}}</view>
  </view>

  <!-- 完成方式与提醒通道：两条都是「新增时的默认行为」，可逐条改 -->
  <view wx:if="{{!isShared}}" class="card">
    <view class="field" style="border-bottom:none;padding-bottom:12rpx">
      <text class="field-label">需要手工确认完成</text>
      <switch checked="{{manualDone}}" color="#2f6bff" bindchange="onManualDone" />
    </view>
    <view class="small muted" style="line-height:1.6">
      默认关闭：提醒发完就自动完成并归档到「提醒记录」。打开后，到点不会自动算完成，会留在待办页标「待确认完成」，必须你点「确认做完了」才算做完。
    </view>
    <view class="divider"></view>
    <view class="field" style="border-bottom:none;padding-bottom:12rpx">
      <text class="field-label">{{isEdit ? '重新写入手机日历' : '保存时写入手机日历'}}</text>
      <switch checked="{{autoCalendar}}" color="#2f6bff" bindchange="onAutoCalendar" />
    </view>
    <view class="small muted" style="line-height:1.6">{{calendarHint}}</view>
  </view>

  <!-- catchtap：日历 API 与订阅授权弹窗不能并发，保存按钮截断根节点 onAnyTap，
       onSave 里按「本次要不要写日历」决定把这次点击的手势让给谁。 -->
  <view wx:if="{{!isShared}}" class="btn {{saving ? 'btn-saving' : ''}}" catchtap="onSave">{{saving ? '保存中…' : saveText}}</view>

  <!-- 系统日历手动补写：新建保存时已默认自动写入，这里用于重试 / 编辑后重新写入。
       保持独立按钮是因为日历 API 必须在点击同步链里调用，且没有删除事件的接口。 -->
  <view wx:if="{{!isShared}}" class="card" style="margin-top:24rpx">
    <view class="row-between">
      <text class="title">手机日历 · 手动补写</text>
      <text class="tag tag-green">不耗微信额度</text>
    </view>
    <view class="small muted" style="margin-top:12rpx;line-height:1.6">
      新建保存时已默认写入。这里用于自动写入失败后重试、或修改时间后重新写入一条；写入的是当前编辑内容，不需要先保存。
    </view>
    <!-- catchtap：日历授权弹窗不能和根节点的订阅授权并发 -->
    <view class="btn btn-ghost" style="margin-top:20rpx" catchtap="onWriteCalendar">重新写入这条待办到手机日历</view>
    <view class="small" style="margin-top:16rpx;line-height:1.6;color:#92400e">
      仅支持「仅一次」和按天 / 周 / 月 / 年且间隔为 1 的重复；不含节假日智能顺延。微信没有删除已添加日历事件的接口，改时间或删除待办不会同步删掉旧提醒，需要到手机日历 App 手动删。
    </view>
  </view>

  <!-- 协作提醒：原件显示参与人数与邀请入口；副本只读 -->
  <view wx:if="{{isShared}}" class="card">
    <view class="title">协作待办</view>
    <view class="divider"></view>
    <view class="small muted">这条待办由好友创建并邀请你一起提醒，内容由创建者统一维护，你这边只读。</view>
    <view class="btn btn-danger" style="margin-top:28rpx" bindtap="onLeave">退出协作提醒</view>
  </view>

  <view wx:elif="{{isEdit}}" class="card">
    <view class="row-between">
      <text class="field-label">协作提醒</text>
      <view wx:if="{{inviteId}}" class="tag tag-green">共 {{memberCount + 1}} 人</view>
      <view wx:else class="tag tag-gray">仅自己</view>
    </view>
    <view class="divider"></view>
    <view class="small muted">需要时再转发给微信好友，对方同意后这条待办会同步加到他的列表，到点大家一起收到提醒。不邀请也不影响，这条待办照常提醒你。</view>
    <button wx:if="{{inviteId}}" class="btn share-btn" open-type="share">邀请微信好友一起提醒</button>
    <view wx:else class="small muted" style="margin-top:16rpx">邀请尚未就绪，点下方按钮重试；若一直失败，请重新部署云函数 pushapi。</view>
    <view class="btn btn-ghost" style="margin-top:16rpx" bindtap="goInvite">邀请详情与邀请码</view>
  </view>

  <view wx:else class="card">
    <view class="title">协作提醒</view>
    <view class="divider"></view>
    <view class="small muted">保存后回到本页，就能在这里转发给微信好友；对方同意后会同步加到他的列表，到点大家一起收到提醒。这是可选项，不邀请这条待办也照常提醒你。</view>
  </view>

  <view wx:if="{{isEdit && !isShared}}" class="btn btn-danger" style="margin-top:24rpx" bindtap="onDelete">删除这条待办</view>

  <!-- 自定义滚轮选择器：替代原生 picker（原生滚轮字号系统固定，无法调大） -->
  <view class="cp-mask {{cpVisible ? 'cp-show' : ''}}" bindtap="onCpCancel">
    <view class="cp-panel" catchtap="cpNoop">
      <view class="cp-bar">
        <text class="cp-cancel" bindtap="onCpCancel">取消</text>
        <text class="cp-title">{{cpTitle}}</text>
        <text class="cp-confirm" bindtap="onCpConfirm">确定</text>
      </view>
      <picker-view
        class="cp-view"
        indicator-style="height: 88rpx; border-top: 1rpx solid rgba(16,24,40,0.08); border-bottom: 1rpx solid rgba(16,24,40,0.08);"
        value="{{cpValue}}"
        bindchange="onCpChange"
      >
        <picker-view-column wx:for="{{cpColumns}}" wx:for-item="col" wx:for-index="ci" wx:key="key">
          <view wx:for="{{col.items}}" wx:for-item="opt" wx:key="*this" class="cp-item">{{opt}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 「按日历选择」的月历多选面板：可往后加载，节假日/调休补班带标记 -->
  <view class="cp-mask {{calVisible ? 'cp-show' : ''}}" bindtap="onCalCancel">
    <view class="cal-panel" catchtap="cpNoop">
      <view class="cp-bar">
        <text class="cp-cancel" bindtap="onCalCancel">取消</text>
        <text class="cp-title">选择提醒日期（{{repeatDates.length}}）</text>
        <text class="cp-confirm" bindtap="onCalConfirm">确定</text>
      </view>
      <view class="cal-week">
        <text wx:for="{{weekHead}}" wx:key="*this" class="cal-week-cell">{{item}}</text>
      </view>
      <scroll-view class="cal-body" scroll-y>
        <view wx:for="{{calMonths}}" wx:for-index="mi" wx:key="key" class="cal-month">
          <text class="cal-month-title">{{item.title}}</text>
          <view class="cal-grid">
            <view
              wx:for="{{item.days}}"
              wx:for-item="day"
              wx:for-index="di"
              wx:key="id"
              class="cal-cell {{day.date ? '' : 'cal-cell-blank'}} {{day.selected ? 'cal-cell-on' : ''}} {{day.today ? 'cal-cell-today' : ''}} {{day.past ? 'cal-cell-past' : ''}} {{day.kind === 'holiday' ? 'cal-cell-off' : ''}}"
              data-date="{{day.date}}"
              data-mi="{{mi}}"
              data-di="{{di}}"
              bindtap="onCalPick"
            >
              <text class="cal-day">{{day.label}}</text>
              <text class="cal-mark">{{day.mark}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{calCanMore}}" class="cal-more" bindtap="onCalMore">再加载 6 个月</view>
        <view style="height:24rpx"></view>
      </scroll-view>
      <view class="cal-foot">
        <text class="small muted">「休」法定节假日，「班」调休补班；再点一次可取消选中。</text>
        <view class="cal-clear" bindtap="onCalClear">清空</view>
      </view>
    </view>
  </view>

</view>
