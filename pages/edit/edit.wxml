<view class="container" bindtap="onAnyTap">

  <view class="card">
    <view class="field">
      <text class="field-label">{{T.f_title}}</text>
      <input
        class="input"
        placeholder="{{T.title_ph}}"
        maxlength="40"
        value="{{title}}"
        disabled="{{isShared}}"
        bindinput="onTitle"
      />
    </view>
    <view class="field" style="border-bottom:none">
      <text class="field-label">{{T.f_note}}</text>
    </view>
      <textarea
      class="note-area"
      placeholder="{{T.note_ph}}"
      maxlength="200"
      value="{{note}}"
      disabled="{{isShared}}"
      bindinput="onNote"
    />

    <!-- 图片备注：选图即传云存储，只存 fileID -->
    <view class="sub-field">
      <view class="row-between">
        <text class="field-label">{{T.ed_image}}</text>
        <text class="small muted">{{images.length}}/{{maxImages}}</text>
      </view>
      <view class="img-grid">
        <view
          wx:for="{{images}}"
          wx:key="*this"
          class="img-cell"
        >
          <image
            class="img-thumb"
            src="{{item}}"
            mode="aspectFill"
            data-src="{{item}}"
            bindtap="onPreviewImage"
          />
          <view
            wx:if="{{!isShared}}"
            class="img-del"
            data-index="{{index}}"
            catchtap="onDelImage"
          >×</view>
        </view>
        <view
          wx:if="{{!isShared && images.length < maxImages}}"
          class="img-add"
          bindtap="onAddImage"
        >＋</view>
      </view>
    </view>

    <!-- 位置备注：选点后存名称/地址/经纬度 -->
    <view class="sub-field">
      <view class="row-between">
        <text class="field-label">{{T.ed_location}}</text>
        <text wx:if="{{!location}}" class="small muted">{{T.ed_not_added}}</text>
      </view>
      <view wx:if="{{location}}" class="loc-row" bindtap="onOpenLocation">
        <view class="loc-text">
          <text class="loc-name">{{location.name}}</text>
          <text class="small muted loc-addr">{{location.address}}</text>
        </view>
        <text class="small link">{{T.ed_view_map}}</text>
      </view>
      <view wx:if="{{!isShared}}" class="row" style="margin-top:20rpx">
        <view class="btn btn-ghost btn-inline" bindtap="onChooseLocation">{{location ? T.ed_relocate : T.ed_choose_location}}</view>
        <view wx:if="{{location}}" class="btn btn-ghost btn-inline" bindtap="onClearLocation">{{T.ed_clear_location}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="field" style="border-bottom:none">
      <text class="field-label">{{T.f_prio}}</text>
      <view class="picker-value priority-{{priorityIndex === 0 ? 'high' : (priorityIndex === 2 ? 'low' : 'medium')}}" bindtap="openCp" data-type="priority">
        {{priorityNames[priorityIndex]}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">{{T.ed_remind_date}}</text>
      <view class="picker-value" bindtap="openCp" data-type="date">{{dateStr}} {{weekdayText}}</view>
    </view>
    <view class="field" style="border-bottom:none">
      <text class="field-label">{{T.f_time}}</text>
      <view class="picker-value" bindtap="openCp" data-type="time">{{timeStr}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">{{T.f_repeat}}</text>
      <view class="picker-value" bindtap="openCp" data-type="repeat">{{repeatNames[repeatIndex]}}</view>
    </view>
    <!-- 按日历选择：日期清单 + 月历多选面板 -->
    <view wx:if="{{showDates}}" class="field" style="{{showHoliday ? '' : 'border-bottom:none'}}">
      <text class="field-label">{{T.ed_pick_dates}}</text>
      <view class="picker-value" bindtap="openCalendar">{{repeatDates.length ? T.ed_sel_prefix + repeatDates.length + T.ed_sel_suffix : T.ed_tap_pick}}</view>
    </view>
    <view wx:if="{{showDates && !repeatDates.length}}" class="sub-field">
      <view class="small muted">{{T.ed_dates_hint_empty}}</view>
    </view>
    <view wx:if="{{showDates && repeatDates.length}}" class="sub-field">
      <view class="chip-wrap">
        <view
          wx:for="{{repeatDates}}"
          wx:key="*this"
          class="chip chip-sm chip-on"
          data-date="{{item}}"
          bindtap="onRemoveDate"
        >{{item}} ×</view>
      </view>
      <view class="small muted" style="margin-top:16rpx">{{T.ed_dates_hint}}</view>
    </view>
    <view wx:if="{{showInterval}}" class="field">
      <text class="field-label">{{intervalLabel}}（{{intervalRange}}）</text>
      <input
        class="input"
        type="number"
        maxlength="3"
        value="{{intervalText}}"
        bindinput="onInterval"
      />
    </view>
    <view wx:if="{{showHoliday}}" class="field">
      <text class="field-label">{{holidaySkipText}}</text>
      <switch checked="{{skipHoliday}}" color="#2f6bff" disabled="{{isShared}}" bindchange="onSkipHoliday" />
    </view>
    <view wx:if="{{showHoliday && skipHoliday}}" class="field" style="border-bottom:none">
      <text class="field-label">{{T.f_on_holiday}}</text>
      <view class="picker-value" bindtap="openCp" data-type="action">{{actionNames[actionIndex]}}</view>
    </view>
  </view>

  <!-- 重复的生效日期范围：只在几号到几号之间提醒（单端留空 = 该端不限） -->
  <view wx:if="{{showRange}}" class="card">
    <view class="field" style="{{rangeEnabled ? '' : 'border-bottom:none'}}">
      <text class="field-label">{{T.ed_range_limit}}</text>
      <switch checked="{{rangeEnabled}}" color="#2f6bff" disabled="{{isShared}}" bindchange="onRangeToggle" />
    </view>
    <view wx:if="{{rangeEnabled}}" class="field">
      <text class="field-label">{{T.ed_range_start}}</text>
      <view class="picker-value" bindtap="openCp" data-type="rangeStart">{{rangeStart || T.ed_unlimited}}</view>
    </view>
    <view wx:if="{{rangeEnabled}}" class="field" style="border-bottom:none">
      <text class="field-label">{{T.ed_range_end}}</text>
      <view class="picker-value" bindtap="openCp" data-type="rangeEnd">{{rangeEnd || T.ed_unlimited}}</view>
    </view>
    <view wx:if="{{rangeEnabled}}" class="small muted" style="margin-top:16rpx">{{rangeHint}}</view>
  </view>

  <view class="card">
    <view class="title">{{T.ed_preview_title}}</view>
    <view class="divider"></view>
    <view class="row-between">
      <text class="small muted">{{T.ed_first_remind}}</text>
      <text class="small">{{previewFirst}}</text>
    </view>
    <view class="row-between" style="margin-top:12rpx">
      <text class="small muted">{{T.next_remind}}</text>
      <text class="small next-text">{{previewNext}}</text>
    </view>
    <view class="small muted" style="margin-top:12rpx">{{previewTip}}</view>
  </view>

  <!-- 完成方式与提醒通道：两条都是「新增时的默认行为」，可逐条改 -->
  <view wx:if="{{!isShared}}" class="card">
    <view class="field" style="border-bottom:none;padding-bottom:12rpx">
      <text class="field-label">{{T.f_manual}}</text>
      <switch checked="{{manualDone}}" color="#2f6bff" bindchange="onManualDone" />
    </view>
    <view class="small muted" style="line-height:1.6">
      {{T.ed_manual_hint}}
    </view>
    <view class="divider"></view>
    <view class="field" style="border-bottom:none;padding-bottom:12rpx">
      <text class="field-label">{{isEdit ? T.ed_calendar_rewrite : T.ed_calendar_save}}</text>
      <switch checked="{{autoCalendar}}" color="#2f6bff" bindchange="onAutoCalendar" />
    </view>
    <view class="small muted" style="line-height:1.6">{{calendarHint}}</view>
  </view>

  <!-- catchtap：日历 API 与订阅授权弹窗不能并发，保存按钮截断根节点 onAnyTap，
       onSave 里按「本次要不要写日历」决定把这次点击的手势让给谁。 -->
  <view wx:if="{{!isShared}}" class="btn {{saving ? 'btn-saving' : ''}}" catchtap="onSave">{{saving ? T.saving : saveText}}</view>

  <!-- 系统日历手动补写：新建保存时已默认自动写入，这里用于重试 / 编辑后重新写入。
       保持独立按钮是因为日历 API 必须在点击同步链里调用，且没有删除事件的接口。 -->
  <view wx:if="{{!isShared}}" class="card" style="margin-top:24rpx">
    <view class="row-between">
      <text class="title">{{T.ed_calendar_manual_title}}</text>
      <text class="tag tag-green">{{T.ed_calendar_free}}</text>
    </view>
    <view class="small muted" style="margin-top:12rpx;line-height:1.6">
      {{T.ed_calendar_manual_hint}}
    </view>
    <!-- catchtap：日历授权弹窗不能和根节点的订阅授权并发 -->
    <view class="btn btn-ghost" style="margin-top:20rpx" catchtap="onWriteCalendar">{{T.ed_calendar_rewrite_btn}}</view>
    <view class="small" style="margin-top:16rpx;line-height:1.6;color:#92400e">
      {{T.ed_calendar_support_hint}}
    </view>
  </view>

  <!-- 协作提醒：原件显示参与人数与邀请入口；副本只读 -->
  <view wx:if="{{isShared}}" class="card">
    <view class="title">{{T.ed_collab_title}}</view>
    <view class="divider"></view>
    <view class="small muted">{{T.ed_collab_shared_hint}}</view>
    <view class="btn btn-danger" style="margin-top:28rpx" bindtap="onLeave">{{T.ed_leave_btn}}</view>
  </view>

  <view wx:elif="{{isEdit}}" class="card">
    <view class="row-between">
      <text class="field-label">{{T.ed_collab_title}}</text>
      <view wx:if="{{inviteId}}" class="tag tag-green">{{T.ed_member_prefix}}{{memberCount + 1}}{{T.ed_member_unit}}</view>
      <view wx:else class="tag tag-gray">{{T.ed_only_self}}</view>
    </view>
    <view class="divider"></view>
    <view class="small muted">{{T.ed_collab_hint}}</view>
    <button wx:if="{{inviteId}}" class="btn share-btn" open-type="share">{{T.ed_invite_btn}}</button>
    <view wx:else class="small muted" style="margin-top:16rpx">{{T.ed_invite_not_ready_hint}}</view>
    <view class="btn btn-ghost" style="margin-top:16rpx" bindtap="goInvite">{{T.ed_invite_detail}}</view>
  </view>

  <view wx:else class="card">
    <view class="title">{{T.ed_collab_title}}</view>
    <view class="divider"></view>
    <view class="small muted">{{T.ed_collab_new_hint}}</view>
  </view>

  <view wx:if="{{isEdit && !isShared}}" class="btn btn-danger" style="margin-top:24rpx" bindtap="onDelete">{{T.ed_delete_btn}}</view>

  <!-- 自定义滚轮选择器：替代原生 picker（原生滚轮字号系统固定，无法调大） -->
  <view class="cp-mask {{cpVisible ? 'cp-show' : ''}}" bindtap="onCpCancel">
    <view class="cp-panel" catchtap="cpNoop">
      <view class="cp-bar">
        <text class="cp-cancel" bindtap="onCpCancel">{{T.cancel}}</text>
        <text class="cp-title">{{cpTitle}}</text>
        <text class="cp-confirm" bindtap="onCpConfirm">{{T.ed_confirm}}</text>
      </view>
      <picker-view
        class="cp-view"
        indicator-style="height: 88rpx; border-top: 1rpx solid rgba(16,24,40,0.08); border-bottom: 1rpx solid rgba(16,24,40,0.08);"
        value="{{cpValue}}"
        bindchange="onCpChange"
      >
        <picker-view-column wx:for="{{cpColumns}}" wx:for-item="col" wx:for-index="ci" wx:key="key">
          <view wx:for="{{col.items}}" wx:for-item="opt" wx:key="*this" class="cp-item">{{opt}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 「按日历选择」的月历多选面板：可往后加载，节假日/调休补班带标记 -->
  <view class="cp-mask {{calVisible ? 'cp-show' : ''}}" bindtap="onCalCancel">
    <view class="cal-panel" catchtap="cpNoop">
      <view class="cp-bar">
        <text class="cp-cancel" bindtap="onCalCancel">{{T.cancel}}</text>
        <text class="cp-title">{{T.ed_pick_dates}}（{{repeatDates.length}}）</text>
        <text class="cp-confirm" bindtap="onCalConfirm">{{T.ed_confirm}}</text>
      </view>
      <view class="cal-week">
        <text wx:for="{{weekHead}}" wx:key="*this" class="cal-week-cell">{{item}}</text>
      </view>
      <scroll-view class="cal-body" scroll-y>
        <view wx:for="{{calMonths}}" wx:for-index="mi" wx:key="key" class="cal-month">
          <text class="cal-month-title">{{item.title}}</text>
          <view class="cal-grid">
            <view
              wx:for="{{item.days}}"
              wx:for-item="day"
              wx:for-index="di"
              wx:key="id"
              class="cal-cell {{day.date ? '' : 'cal-cell-blank'}} {{day.selected ? 'cal-cell-on' : ''}} {{day.today ? 'cal-cell-today' : ''}} {{day.past ? 'cal-cell-past' : ''}} {{day.kind === 'holiday' ? 'cal-cell-off' : ''}}"
              data-date="{{day.date}}"
              data-mi="{{mi}}"
              data-di="{{di}}"
              bindtap="onCalPick"
            >
              <text class="cal-day">{{day.label}}</text>
              <text class="cal-mark">{{day.mark}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{calCanMore}}" class="cal-more" bindtap="onCalMore">{{T.ed_cal_more}}</view>
        <view style="height:24rpx"></view>
      </scroll-view>
      <view class="cal-foot">
        <text class="small muted">{{T.ed_cal_foot}}</text>
        <view class="cal-clear" bindtap="onCalClear">{{T.idx_clear}}</view>
      </view>
    </view>
  </view>

</view>
