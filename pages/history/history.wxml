<view class="container" bindtap="onAnyTap">

  <view class="page-header">
    <view class="row-between">
      <text class="page-title">{{T.hist_title}}</text>
      <view class="seg">
        <text class="seg-item {{viewMode === 'calendar' ? 'seg-item-on' : ''}}" data-mode="calendar" bindtap="onViewMode">{{T.hist_calendar}}</text>
        <text class="seg-item {{viewMode === 'list' ? 'seg-item-on' : ''}}" data-mode="list" bindtap="onViewMode">{{T.hist_list}}</text>
      </view>
    </view>
    <view class="page-subtitle">{{totalText}}</view>
  </view>

  <block wx:if="{{viewMode === 'calendar'}}">
    <view class="card">
      <view class="row-between">
        <text class="cal-title">{{calTitle}}</text>
        <view class="row">
          <text class="chip" bindtap="onToday">{{T.hist_today}}</text>
          <text class="chip" bindtap="onPrevMonth">‹</text>
          <text class="chip" bindtap="onNextMonth">›</text>
        </view>
      </view>

      <view class="cal-week">
        <text wx:for="{{weekLabels}}" wx:key="*this" class="cal-week-item">{{item}}</text>
      </view>

      <view class="cal-grid">
        <view
          wx:for="{{calDays}}"
          wx:key="key"
          class="cal-cell {{item.inMonth ? '' : 'cal-cell-out'}}"
          data-date="{{item.key}}"
          bindtap="onSelectDay"
        >
          <view class="cal-num {{item.isToday ? 'cal-num-today' : ''}} {{item.selected ? 'cal-num-on' : ''}}">{{item.day}}</view>
          <view class="cal-dots">
            <text wx:if="{{item.count > 0}}" class="cal-dot"></text>
            <text wx:if="{{item.count > 1}}" class="cal-dot"></text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="title">{{calSelectedText}}</text>
        <text class="small muted">{{dayLogs.length}}</text>
      </view>
      <view wx:if="{{dayLogs.length === 0}}" class="small muted" style="margin-top:16rpx">{{T.hist_empty2}}</view>

      <view
        wx:for="{{dayLogs}}"
        wx:key="id"
        class="day-card"
        bindlongpress="onLongPress"
        data-id="{{item.id}}"
        data-title="{{item.todoTitle}}"
      >
        <view class="row-between">
          <text class="log-title">{{item.timeText}} {{item.todoTitle}}</text>
          <view class="tag {{item.status === 'skipped' ? 'tag-orange' : 'tag-green'}}">{{item.status === 'skipped' ? T.mp_idx_holiday_skip : T.idx_reminded}}</view>
        </view>
        <view class="row" style="margin-top:10rpx">
          <view class="tag priority-{{item.priority}}">{{T.idx_prio_prefix}} {{item.priorityText}}</view>
        </view>
        <view wx:if="{{item.remark}}" class="small remark">{{item.remark}}</view>
      </view>
    </view>
  </block>

  <view class="card">
    <input
      class="search-input"
      placeholder="{{T.hist_search_ph}}"
      maxlength="30"
      value="{{keyword}}"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <view class="row-between" style="margin-top:20rpx">
      <text class="small muted">{{T.idx_sort}}</text>
      <view class="row">
        <view class="seg">
          <text class="seg-item {{sortMode === 'priority' ? 'seg-item-on' : ''}}" data-mode="priority" bindtap="onSort">{{T.idx_sort_prio}}</text>
          <text class="seg-item {{sortMode === 'time' ? 'seg-item-on' : ''}}" data-mode="time" bindtap="onSort">{{T.idx_sort_time}}</text>
        </view>
        <text class="chip" bindtap="onToggleFilter">{{showFilter ? T.idx_filter_hide : T.idx_filter}}</text>
      </view>
    </view>

    <block wx:if="{{showFilter}}">
      <view class="divider"></view>
      <view class="row-between">
        <text class="small muted">{{T.idx_prio_prefix}}</text>
        <view class="row">
          <text
            wx:for="{{priorityFilters}}"
            wx:key="key"
            class="chip {{filterPriority === item.key ? 'chip-on' : ''}}"
            data-value="{{item.key}}"
            bindtap="onPriorityFilter"
          >{{item.name}}</text>
        </view>
      </view>

      <view class="row-between" style="margin-top:16rpx">
        <text class="small muted">{{T.idx_date_range}}</text>
        <view class="row">
          <picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom">
            <text class="chip chip-sm">{{dateFromText || T.idx_start}}</text>
          </picker>
          <text class="small muted" style="margin:0 6rpx">~</text>
          <picker mode="date" value="{{dateTo}}" bindchange="onDateTo">
            <text class="chip chip-sm">{{dateToText || T.idx_end}}</text>
          </picker>
        </view>
      </view>

      <view class="row-between" style="margin-top:16rpx">
        <text class="small muted">{{T.idx_time_range}}</text>
        <view class="row">
          <picker mode="time" value="{{timeFrom}}" bindchange="onTimeFrom">
            <text class="chip chip-sm">{{timeFrom || T.idx_start}}</text>
          </picker>
          <text class="small muted" style="margin:0 6rpx">~</text>
          <picker mode="time" value="{{timeTo}}" bindchange="onTimeTo">
            <text class="chip chip-sm">{{timeTo || T.idx_end}}</text>
          </picker>
        </view>
      </view>

      <view class="row-between" style="margin-top:16rpx">
        <text class="small muted">{{filterText || T.idx_no_filter}}</text>
        <text class="link" bindtap="onClearFilter">{{T.idx_reset}}</text>
      </view>
    </block>
  </view>

  <view wx:if="{{!signedIn}}" class="empty">
    <view>{{T.hist_need_login}}</view>
  </view>

  <view wx:if="{{loading && logs.length === 0}}" class="empty">{{T.idx_loading}}</view>

  <view wx:if="{{viewMode === 'list' && signedIn && !loading && logs.length === 0}}" class="empty">
    <view>{{T.hist_empty2}}</view>
    <view class="small" style="margin-top:16rpx">{{T.hist_empty_desc}}</view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{signedIn && logs.length > 0}}" class="small muted" style="margin:0 8rpx 16rpx">
      {{T.hist_tap_hint}}
    </view>
    <view
      wx:for="{{logs}}"
      wx:key="id"
      class="card log-card"
      bindtap="onLogItem"
      bindlongpress="onLongPress"
      data-id="{{item.id}}"
      data-title="{{item.todoTitle}}"
    >
      <view class="row-between">
        <text class="log-title">{{item.todoTitle}}</text>
        <view class="tag {{item.status === 'skipped' ? 'tag-orange' : 'tag-green'}}">{{item.status === 'skipped' ? T.mp_idx_holiday_skip : T.idx_reminded}}</view>
      </view>
      <view class="row" style="margin-top:10rpx">
        <view class="tag priority-{{item.priority}}">{{T.idx_prio_prefix}} {{item.priorityText}}</view>
      </view>
      <view class="small muted" style="margin-top:10rpx">{{T.f_time}} {{item.atText}}</view>
      <view wx:if="{{item.remark}}" class="small remark">{{item.remark}}</view>
    </view>
  </block>

  <!-- 手工确认完成的 + 默认自动完成的都收在这里 -->
  <block wx:if="{{signedIn && finishedItems.length > 0}}">
    <view class="section-title">{{T.hist_finished_prefix}}（{{finishedItems.length}}）</view>
    <view
      wx:for="{{finishedItems}}"
      wx:key="id"
      class="card finished-card"
      bindtap="goEditTodo"
      data-id="{{item.id}}"
    >
      <view class="row-between">
        <text class="finished-title">{{item.title}}</text>
        <view class="tag tag-gray">{{item.repeatText}}</view>
      </view>
      <view class="row" style="margin-top:10rpx">
        <view class="tag priority-{{item.priority}}">{{T.idx_prio_prefix}} {{item.priorityText}}</view>
        <view class="tag tag-gray">{{item.doneText}}</view>
      </view>
      <view class="small muted" style="margin-top:10rpx">{{T.f_time}} {{item.remindText}}<block wx:if="{{item.lastText}}">{{T.hist_last_prefix}} {{item.lastText}}</block><block wx:if="{{item.doneAtText}}"> · {{item.doneAtText}}{{T.hist_manual_suffix}}</block></view>
    </view>
    <view class="small muted tip">{{T.hist_tip}}</view>
  </block>

</view>
