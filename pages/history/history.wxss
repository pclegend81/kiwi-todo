.search-input {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 22rpx 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #10151c;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.log-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #10151c;
  flex: 1;
  margin-right: 16rpx;
  word-break: break-all;
}

.remark {
  margin-top: 12rpx;
  color: #b45309;
  font-weight: 600;
}

/* ── 苹果日历风格 ─────────────────────────────────────────────────────── */

.cal-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #10151c;
}

.cal-week {
  display: flex;
  margin-top: 24rpx;
  padding-bottom: 8rpx;
}

.cal-week-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #8b8f98;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.285%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0 10rpx;
}

.cal-cell-out {
  opacity: 0.32;
}

.cal-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #10151c;
  font-variant-numeric: tabular-nums;
}

/* 今天：iOS 红字 */
.cal-num-today {
  color: #ff3b30;
  font-weight: 700;
}

/* 选中：iOS 实心红圆 + 白字 */
.cal-num-on {
  background: #ff3b30;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(255, 59, 48, 0.34);
}

.cal-dots {
  height: 12rpx;
  margin-top: 6rpx;
  display: flex;
  justify-content: center;
}

.cal-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 0 3rpx;
  border-radius: 999rpx;
  background: #007aff;
}

.cal-num-on + .cal-dots .cal-dot {
  background: #007aff;
}

/* 当日列表：扁平行，跟随玻璃卡 */
.day-card {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(16, 24, 40, 0.07);
}


.link {
  color: #007aff;
  font-size: 30rpx;
  font-weight: 700;
}
