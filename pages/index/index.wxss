/* ==========================================================================
   待办列表紧凑布局：目标是一屏至少放得下 3 条（原布局一条约 500rpx，只能看 2 条）。
   只作用于首页，全局 .card / .tag 保持不变，编辑页、提醒记录页不受影响。
   压缩来源：卡片内边距 32→20rpx、卡片间距 24→16rpx、两行标签并成一行、
   分隔线留白 24→12rpx、完成/删除胶囊变矮、行高 1.55→1.35。
   ========================================================================== */

/* 头部与筛选卡也一起收一点，把空间让给列表 */
.page-header {
  padding-bottom: 16rpx;
}

.sort-card {
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
}

.todo-card {
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  line-height: 1.35;
}

.todo-card .todo-title {
  font-size: 32rpx;
  margin-right: 12rpx;
}

/* 标签只压内边距，字号维持 26rpx，别把信息做小到看不清 */
.todo-card .tag {
  padding: 6rpx 14rpx;
  line-height: 1.2;
}

/* 一行放不下（同时有待确认/协作/附件时）自动折行，而不是被挤到变形或溢出 */
.todo-tags {
  flex-wrap: wrap;
  margin-bottom: -8rpx;
}

.todo-tags .tag {
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.todo-card .note {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.todo-divider {
  height: 1rpx;
  background: rgba(16, 24, 40, 0.08);
  margin: 12rpx 0;
}

.todo-card .small {
  font-size: 26rpx;
}

.todo-card .next-text,
.todo-card .pending-text {
  font-size: 28rpx;
}

.todo-actions {
  margin-top: 10rpx;
}

/* 完成 / 删除胶囊变矮：从 14rpx 30rpx → 8rpx 22rpx */
.todo-card .done-btn,
.todo-card .del-btn {
  padding: 8rpx 22rpx;
  font-size: 26rpx;
}

.banner-card {
  background: rgba(0, 122, 255, 0.10);
  border: 1rpx solid rgba(0, 122, 255, 0.20);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8),
    0 16rpx 40rpx rgba(0, 122, 255, 0.10);
  /* 到期提醒横幅也收紧，别把列表往下顶 */
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.fresh-item {
  padding: 10rpx 0;
}

.fresh-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #10151c;
}

.todo-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #10151c;
  word-break: break-all;
}

.note {
  margin-top: 12rpx;
  line-height: 1.6;
  word-break: break-all;
}

.next-text {
  color: #007aff;
  font-size: 30rpx;
  font-weight: 700;
}

.pending-text {
  color: #d70015;
  font-size: 30rpx;
  font-weight: 700;
}

/* 手工确认完成：做成小胶囊而不是整行按钮，避免误触 */
.done-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.72);
  color: #007aff;
  border: 2rpx solid rgba(0, 122, 255, 0.32);
}

/* 提醒已发完还挂着没确认：用实心主色强调，催一下 */
.done-btn-on {
  background: linear-gradient(180deg, #3d9aff 0%, #007aff 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.26);
}

/* 卡片上的单条删除：红色幽灵胶囊，推到最右，和蓝色完成按钮拉开距离防误触 */
.del-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: auto;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  background: rgba(255, 59, 48, 0.08);
  color: #d70015;
  border: 2rpx solid rgba(255, 59, 48, 0.32);
}

/* ── 批量确认完成 ───────────────────────────────────────────────────────── */

.batch-panel {
  background: rgba(0, 122, 255, 0.10);
  border: 1rpx solid rgba(0, 122, 255, 0.22);
}

.card-checked {
  background: rgba(0, 122, 255, 0.12);
  box-shadow:
    inset 0 0 0 2rpx rgba(0, 122, 255, 0.38),
    0 0 0 1rpx rgba(16, 24, 40, 0.05),
    0 16rpx 40rpx rgba(0, 122, 255, 0.10);
}

.check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(120, 130, 150, 0.55);
  background: rgba(255, 255, 255, 0.85);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.check-box-on {
  background: #007aff;
  border-color: #007aff;
}

.batch-count {
  color: #007aff;
  font-weight: 700;
  white-space: nowrap;
}

/* 两个操作各占一半宽度：删除 / 确认完成并排，不靠 margin 挤在右侧 */
.btn-batch {
  flex: 1;
  min-width: 0;
  padding: 18rpx 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  white-space: nowrap;
  text-align: center;
}

.btn-batch-del {
  margin-right: 16rpx;
}

.batch-actions {
  margin-top: 16rpx;
}

/* 浮在自定义 tabBar（108rpx + 20rpx 底距）上方，不遮标签栏 */
.batch-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  z-index: 500;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 0 0 1rpx rgba(16, 24, 40, 0.05),
    0 16rpx 40rpx rgba(16, 24, 40, 0.18);
}

