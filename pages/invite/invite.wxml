<view class="container" bindtap="onAnyTap">

  <view wx:if="{{loading}}" class="empty">{{T.idx_loading}}</view>

  <block wx:if="{{!loading && errorText}}">
    <view class="card">
      <view class="title">{{T.inv_open_fail_title}}</view>
      <view class="small muted" style="margin-top:12rpx">{{errorText}}</view>
      <view class="btn btn-ghost" style="margin-top:28rpx" bindtap="goHome">{{T.inv_go_home}}</view>
    </view>
  </block>

  <block wx:if="{{!loading && !errorText}}">

    <view class="invite-hero">
      <view class="invite-hero-title">{{fromNew ? T.inv_hero_owner : T.inv_hero_guest}}</view>
      <view class="invite-hero-sub">{{fromNew ? T.inv_hero_sub_owner : T.inv_hero_sub_guest}}</view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="title todo-title">{{title}}</text>
        <view class="tag tag-blue">{{repeatText}}</view>
      </view>

      <view wx:if="{{note}}" class="small muted note">{{note}}</view>

      <view wx:if="{{images.length}}" class="img-grid">
        <image
          wx:for="{{images}}"
          wx:key="*this"
          class="img-thumb"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="onPreviewImage"
        />
      </view>

      <view wx:if="{{location}}" class="loc-row" bindtap="onOpenLocation">
        <view class="loc-text">
          <text class="loc-name">{{location.name}}</text>
          <text class="small muted loc-addr">{{location.address}}</text>
        </view>
        <text class="small link">{{T.ed_view_map}}</text>
      </view>

      <view class="divider"></view>

      <view class="kv">
        <text class="kv-label">{{T.ed_first_remind}}</text>
        <text class="kv-value">{{remindText}}</text>
      </view>

      <view wx:if="{{datesText}}" class="kv">
        <text class="kv-label">{{T.inv_dates_label}}</text>
        <text class="kv-value">{{datesText}}</text>
      </view>

      <view class="kv">
        <text class="kv-label">{{T.f_prio}}</text>
        <view class="tag priority-{{priorityKey}}">{{priorityText}}</view>
      </view>

      <view class="kv">
        <text class="kv-label">{{T.mp_idx_holiday}}</text>
        <view class="tag tag-gray">{{holidayText}}</view>
      </view>

      <view class="kv">
        <text class="kv-label">{{T.inv_members_label}}</text>
        <text class="kv-value">{{memberCount}}{{T.ed_member_unit}}</text>
      </view>
    </view>

    <view wx:if="{{isOwner}}" class="card">
      <view class="title">{{fromNew ? T.inv_pick_friend : T.inv_owner_invite}}</view>
      <view class="small muted" style="margin-top:12rpx">
        {{T.inv_pick_hint}}
      </view>
      <button class="btn share-btn" open-type="share">{{T.inv_pick_friend}}</button>

      <block wx:if="{{code}}">
        <view class="divider"></view>
        <view class="kv">
          <text class="kv-label">{{T.inv_code_label}}</text>
          <view class="row">
            <text class="code-text">{{code}}</text>
            <view class="btn-mini" bindtap="onCopyCode">{{T.inv_copy}}</view>
          </view>
        </view>
        <view class="small muted tip">
          {{T.inv_code_hint}}
        </view>

        <view wx:if="{{memberNames.length}}" class="divider"></view>
        <view wx:if="{{memberNames.length}}" class="kv">
          <text class="kv-label">{{T.inv_joined_label}}</text>
          <text class="kv-value">{{memberNames.length}}{{T.ed_member_unit}}</text>
        </view>
        <view wx:if="{{memberNames.length}}" class="member-row">
          <view wx:for="{{memberNames}}" wx:key="*this" class="tag tag-indigo">{{item}}</view>
        </view>
      </block>
    </view>

    <view wx:elif="{{joined}}" class="card">
      <view class="title">{{T.inv_already_joined}}</view>
      <view class="small muted" style="margin-top:12rpx">{{T.inv_joined_hint}}</view>
      <view class="btn" style="margin-top:28rpx" bindtap="goHome">{{T.inv_view_mine}}</view>
    </view>

    <block wx:else>
      <view class="btn" bindtap="onAccept">{{busy ? T.inv_joining : T.inv_accept}}</view>
      <view class="small muted tip">{{T.inv_accept_hint}}</view>
    </block>

  </block>
</view>
