.invite-hero {
  padding: 8rpx 8rpx 24rpx;
}

.invite-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #10151c;
  line-height: 1.3;
}

.invite-hero-sub {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #5c6371;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.kv-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #5c6371;
  flex-shrink: 0;
}

.kv-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #10151c;
  text-align: right;
}

.note {
  margin-top: 12rpx;
  line-height: 1.6;
}


/* ── 附件：图片 / 位置 ─────────────────────────────────────────────────── */

.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.img-thumb {
  width: 150rpx;
  height: 150rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 20rpx;
  background: rgba(120, 130, 150, 0.12);
  display: block;
}

.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(120, 130, 150, 0.10);
}

.loc-text {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.loc-name,
.loc-addr {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.loc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #007aff;
}

/* ── 邀请码 / 成员名单 ─────────────────────────────────────────────────── */

.code-text {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #10151c;
}

.btn-mini {
  margin-left: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  flex-shrink: 0;
}

.member-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

/* 去掉原生 button 的默认边框/圆角，视觉上与普通 .btn 一致 */
.share-btn {
  margin-top: 28rpx;
  padding: 0;
  line-height: 1;
}

.share-btn::after {
  border: none;
}
